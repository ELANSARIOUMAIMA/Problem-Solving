class Solution {
    public int maxSubArray(int[] nums) {
        int current=0;
        int result=nums[0];
        for(int num:nums){
            if(current<0){
                current=0;
            }
            current=current+num;
            result=Math.max(result,current);
        }
        return result;
        
    }
}
